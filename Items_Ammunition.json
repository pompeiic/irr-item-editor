		},
		{
			"itemTag": "Inventory.Items.Ammunition.Rounds.12x70",
			"assetPath": "/Game/Blueprints/InventorySystem/Templates/Ammunition/Rounds/12x70/ID_12x70.ID_12x70",
			"name": "12/70mm Buckshot",
			"abbreviation": "12/70",
			"description": "The 12/70mm Buckshot is a shotgun shell designed for close-quarters combat and hunting applications. It features a 12-gauge shell with a length of 70 millimeters. Inside the shell, multiple spherical lead pellets, commonly referred to as 'buckshot,' are loaded. Upon firing, the shell discharges these pellets in a spread pattern, making it highly effective for short-range engagements and hunting larger game. The 12/70mm Buckshot is favored by hunters and law enforcement for its ability to deliver a wide and powerful impact on the target, making it a reliable choice in various scenarios.",
